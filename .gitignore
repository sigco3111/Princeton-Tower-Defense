# ===============================================
# Princeton Tower Defense 한글화 미러 .gitignore
# ===============================================
# Next.js 16 + gh-pages 정적 export에서 빌드 산출물(404/, __next.*.txt, _next/,
# 라우트별 폴더 등)이 실수로 추적되는 것을 방지. 다음 에이전트가 이 함정에
# 빠지지 않도록 명확히 명시.

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
.cursor/
.claude/

# Node / package managers
node_modules/
.pnp.*
.pnpm-store/

# ===============================================
# Next.js 16 build output (절대 추적 금지)
# ===============================================
.next/
out/

# Next.js dynamic route build artifacts
404/
404.html
__next.*.txt
__next.$oc$slug*
_next/

# 빌드된 페이지 폴더들 (라우트별)
_not-found/
ashen_spiral/
blight_basin/
bog/
cannon_crest/
carnegie/
codex/
crater/
credits/
creator/
fortress/
frist_outpost/
glacier/
infernal_gate/
ivy_crossroads/
lava/
mirage_dunes/
nassau/
oasis/
peak/
poe/
pyramid/
sandbox/
settings/
sphinx/
sun_obelisk/
sunken_temple/
sunscorch_labyrinth/
throne/
triad_keep/
whiteout_pass/
witch_hut/

# 빌드된 manifest/webmanifest/sitemap/robots
manifest.webmanifest
sitemap.xml
robots.txt
llms.txt
llms-full.txt

# 빌드된 root HTML
index.html
index.txt
favicon.ico
fonts/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts.bak

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ===============================================
# Large media — 1GB 푸시 한도 보호
# ===============================================
public/videos/

# Legacy / unused images
public/images/old/

# ===============================================
# Environment
# ===============================================
.env.local
.env.development.local
.env.test.local
.env.production.local

# 임시 산출물
.cache/
.DS_Store